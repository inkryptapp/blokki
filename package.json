{
	"name": "blokki",
	"version": "0.0.1",
	"keywords": [
		"svelte"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/inkryptapp/blokki.git"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"default": "./dist/core/index.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test:e2e": "playwright install && playwright test",
		"test": "pnpm run test:unit --run && pnpm run test:e2e",
		"bench": "echo \"No benchmarks yet.\"",
		"size": "size-limit",
		"attw": "attw --pack . --profile esm-only"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/cli": "^3.0.3",
		"@playwright/test": "^1.60.0",
		"@size-limit/esbuild": "^14.2.0",
		"@size-limit/file": "^14.2.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^4.1.8",
		"esbuild-svelte": "^0.9.5",
		"lint-staged": "^17.6.0",
		"oxfmt": "0.72.0",
		"oxlint": "1.87.0",
		"playwright": "^1.60.0",
		"publint": "^0.3.21",
		"size-limit": "^14.2.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,mts,cts,svelte}": [
			"oxlint --fix",
			"oxfmt --no-error-on-unmatched-pattern"
		],
		"!*.{js,mjs,cjs,ts,mts,cts,svelte}": "oxfmt --no-error-on-unmatched-pattern"
	},
	"packageManager": "pnpm@12.11.2"
}
